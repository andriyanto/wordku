<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="WordKu" Manufacturer="andriyanto" Version="$(var.Version)" UpgradeCode="60A65D45-7BD9-4758-A5A2-BE8FA279433E" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="WordKu word processor" Manufacturer="andriyanto" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of WordKu is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WordcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="WordcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andriyanto/wordku" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/andriyanto/wordku" />
    <Property Id="ARPHELPLINK" Value="https://github.com/andriyanto/wordku" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch WordKu (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <!-- Desktop shortcut: a checkbox after the "Who should use WordKu?" page, off for a fresh
         install. An explicit command-line value (DESKTOPSHORTCUT=1 or 0) wins; otherwise the
         previous installation's choice is kept. Run only in the first sequence so the execute
         sequence cannot reload the old choice after the user unchecks the box. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="SAVEDDESKTOPSHORTCUT" Secure="yes" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="LoadDesktopShortcutPreference" Value="1" After="CraftLoadOption1U" Sequence="first" Condition="NOT DESKTOPSHORTCUT AND SAVEDDESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="DefaultDesktopShortcut" Value="0" After="LoadDesktopShortcutPreference" Sequence="first" Condition="NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DesktopShortcutChoice" Value="1" After="DefaultDesktopShortcut" Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />
    <!-- The saved choice of the context being installed (per user or per machine). -->
    <Property Id="CRAFT_OPTION_1_M" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_MSearch" Root="HKLM" Key="Software\WordKu\Installer" Name="DesktopShortcut" Type="raw" /></Property>
    <SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1M" Value="[CRAFT_OPTION_1_M]" After="LaunchConditions" Sequence="both" Condition="ALLUSERS = 1" />
    <Property Id="CRAFT_OPTION_1_U" Secure="yes"><RegistrySearch Id="CRAFT_OPTION_1_USearch" Root="HKCU" Key="Software\WordKu\Installer" Name="DesktopShortcut" Type="raw" /></Property>
    <SetProperty Id="SAVEDDESKTOPSHORTCUT" Action="CraftLoadOption1U" Value="[CRAFT_OPTION_1_U]" After="CraftLoadOption1M" Sequence="both" Condition="ALLUSERS &lt;&gt; 1" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch WordKu" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WordcraftExe]" />
    <CustomAction Id="LaunchWordcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWordcraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Dialog Id="DesktopShortcutDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\CraftScopeTitle}Shortcuts" />
        <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="{\CraftScopeText}WordKu is always added to the Start menu. It can go on the desktop too." />
        <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="20" Y="88" Width="330" Height="18" Property="DesktopShortcutChoice" CheckBoxValue="1" Text="{\CraftScopeText}Create a &amp;desktop shortcut" />
        <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="Next">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Order="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Order="2" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" Order="3" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <!-- Component conditions must see the choice before costing. Not shown during
           basic/silent installs, repair or uninstall. -->
      <Show Dialog="DesktopShortcutDlg" Before="CostInitialize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    </InstallUISequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="Produktivitas">
        <Directory Id="INSTALLFOLDER" Name="WordKu" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="WordKu" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="WordcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="WordcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="WordcraftApp" Guid="69EB4549-06B3-465F-A424-45DBE4126A8B">
        <File Id="WordcraftExe" Source="$(var.BinDir)\wordku.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="WordKu" Description="WordKu word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="WordcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\wordku.exe" Value="[#WordcraftExe]" Type="string" />
      <RegistryValue Root="HKMU" Key="Software\WordKu" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a WordKu ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so WordKu shows in
           Explorer's "Open with". The Word, RTF and ODT types are also WordKu's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="WordcraftFileTypes" Guid="34C75776-4FE5-4E5D-A32D-1DF2D035EF64">
        <RegistryValue Root="HKMU" Key="Software\RegisteredApplications" Name="WordKu" Value="Software\WordKu\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities" Name="ApplicationName" Value="WordKu" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities" Name="ApplicationIcon" Value="&quot;[#WordcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe" Name="FriendlyAppName" Value="WordKu" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="WordKu.Document" Description="Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.Document\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docx\OpenWithProgids" Name="WordKu.Document" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".docx" Value="WordKu.Document" Type="string" />

        <ProgId Id="WordKu.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.DocumentMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.docm\OpenWithProgids" Name="WordKu.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".docm" Value="WordKu.DocumentMacroEnabled" Type="string" />

        <ProgId Id="WordKu.Template" Description="Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.Template\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotx\OpenWithProgids" Name="WordKu.Template" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".dotx" Value="WordKu.Template" Type="string" />

        <ProgId Id="WordKu.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.TemplateMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dotm\OpenWithProgids" Name="WordKu.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".dotm" Value="WordKu.TemplateMacroEnabled" Type="string" />

        <ProgId Id="WordKu.LegacyDocument" Description="Legacy Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.LegacyDocument\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.doc\OpenWithProgids" Name="WordKu.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".doc" Value="WordKu.LegacyDocument" Type="string" />

        <ProgId Id="WordKu.LegacyTemplate" Description="Legacy Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.LegacyTemplate\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.dot\OpenWithProgids" Name="WordKu.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".dot" Value="WordKu.LegacyTemplate" Type="string" />

        <ProgId Id="WordKu.RichText" Description="Rich Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.RichText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.rtf\OpenWithProgids" Name="WordKu.RichText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".rtf" Value="WordKu.RichText" Type="string" />

        <ProgId Id="WordKu.OpenDocumentText" Description="OpenDocument Text" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.OpenDocumentText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.odt\OpenWithProgids" Name="WordKu.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\WordKu\Capabilities\FileAssociations" Name=".odt" Value="WordKu.OpenDocumentText" Type="string" />

        <ProgId Id="WordKu.Markdown" Description="Markdown Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.Markdown\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="WordKu.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="WordKu.PlainText" Description="Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\WordKu.PlainText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="WordKu.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\wordku.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="WordcraftCli">
        <File Id="WordcraftCliExe" Source="$(var.BinDir)\wordku-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKMU" Key="Software\WordKu\Installer" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="WordKu" Description="WordKu word processor" Target="[#WordcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="WordcraftIcon.ico" IconIndex="0" />
        <!-- HKMU resolves to HKLM for a per-machine install, so another account can uninstall
             the marker too. MSI root -1 also satisfies ICE43 for this shortcut. -->
        <RegistryValue Root="HKMU" Key="Software\WordKu\Installer" Name="DesktopShortcutComponent" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
